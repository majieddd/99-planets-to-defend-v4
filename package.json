{
  "name": "99-planets-to-defend-v4",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "99 Planets To Defend v4: a painted, inked action tower defense on procedural planets.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.sim.json",
    "lint": "eslint .",
    "check:emdash": "node tools/check-emdash.mjs",
    "check:blueprint": "node tools/check-blueprint.mjs",
    "check": "npm run typecheck && npm run lint && npm run check:emdash && npm run check:blueprint",
    "test": "vitest run",
    "test:determinism": "vitest run tests/unit/sim/determinism.test.ts",
    "e2e": "playwright test"
  },
  "dependencies": {
    "three": "0.186.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "24.13.6",
    "@types/three": "0.186.0",
    "eslint": "10.11.0",
    "globals": "17.12.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  }
}
