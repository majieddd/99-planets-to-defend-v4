# Dependencies and builds
node_modules/
dist/
.vite/
coverage/

# Test and capture output (evidence worth keeping is copied into docs/evidence/)
playwright-report/
test-results/
artifacts/

# Blender scratch files (recipes are the source; exports in public/assets are committed)
*.blend1
*.blend@
__pycache__/
*.pyc

# npm run assets intermediates (raw GLB exports, bakes, preview renders); what ships is written to
# public/assets and docs/evidence/assets. Anchored to the root: "build" is also a game verb, so a
# nested source folder of that name must stay tracked.
/build/

# Local environment
.env
.env.*
!.env.example
.DS_Store
Thumbs.db
